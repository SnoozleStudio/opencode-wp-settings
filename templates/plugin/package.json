{
  "name": "{plugin_slug}",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "exit 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:php": "php vendor/bin/pint",
    "format:php:check": "php vendor/bin/pint --test",
    "format:all": "npm run format && npm run format:php",
    "format:all:check": "npm run format:check && npm run format:php:check",
    "phpstan": "php vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.3"
  }
}
