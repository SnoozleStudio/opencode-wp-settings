{
  "name": "{theme_slug}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build --watch",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:php": "vendor/bin/pint",
    "format:php:check": "vendor/bin/pint --test",
    "format:all": "npm run format && npm run format:php",
    "format:all:check": "npm run format:check && npm run format:php:check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "tailwindcss": "^4.3.0",
    "tempus": "^1.0.0-dev.18"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "vite": "^8.0.16"
  }
}
