{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "permission": {
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npm run*": "allow",
      "npm install*": "ask",
      "npm info *": "allow",
      "npx prettier": "allow",
      "npx prettier *": "allow",
      "npx tsc": "allow",
      "npx tsc *": "allow",
      "npx -y @upstash/context7-mcp*": "allow",
      "npx skills add*": "ask",
      "npx skills update*": "ask",
      "bun run *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git blame*": "allow",
      "git rev-parse*": "allow",
      "git remote*": "allow",
      "git stash*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "git pull*": "allow",
      "git checkout *": "allow",
      "git checkout -- *": "deny",
      "git checkout .*": "deny",
      "git restore *": "deny",
      "git clean *": "deny",
      "git reset --hard*": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push *--force*": "deny",
      "git push *+*": "deny",
      "git branch *--delete*": "deny",
      "git branch *-f *": "deny",
      "git branch *--force*": "deny",
      "git checkout HEAD -- *": "deny",
      "git checkout * -- .": "deny",
      "composer install*": "ask",
      "composer dump-autoload*": "ask",
      "composer validate*": "allow",
      "composer show*": "allow",
      "composer require*": "ask",
      "composer update*": "ask",
      "vendor/bin/phpcs*": "allow",
      "vendor/bin/phpcbf*": "allow",
      "vendor/bin/pint*": "allow",
      "vendor/bin/phpstan*": "allow",
      "php vendor/bin/phpcs*": "allow",
      "php vendor/bin/phpcbf*": "allow",
      "php vendor/bin/pint*": "allow",
      "php vendor/bin/phpstan*": "allow",
      "php -l *": "allow",
      "wp *": "ask",
      "gh repo view*": "allow",
      "gh pr view*": "allow",
      "gh pr checks*": "allow",
      "gh issue view*": "allow",
      "gh run view*": "allow",
      "gh pr create*": "ask",
      "gh issue create*": "ask",
      "node -e *": "deny",
      "node -p *": "deny",
      "node --eval*": "deny",
      "node --print*": "deny",
      "npm publish*": "ask",
      "curl * | bash": "deny",
      "curl * | sh": "deny",
      "curl * -o *": "deny",
      "curl * -O*": "deny",
      "curl * --data*": "deny",
      "curl * -X POST*": "deny",
      "curl * -X PUT*": "deny",
      "curl * -X DELETE*": "deny",
      "iwr * | iex": "deny",
      "irm * | iex": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "Remove-Item -Recurse*": "deny",
      "Remove-Item * -Recurse*": "deny",
      "rd /s *": "deny",
      "sudo *": "deny",
      "cat ~/.ssh/*": "deny",
      "cat ~/.aws/*": "deny",
      "cat ~/.gnupg/*": "deny",
      "cat ~/.npmrc": "deny",
      "cat ~/.netrc": "deny",
      "cat ~/.docker/config.json": "deny",
      "cat ~/.kube/config": "deny",
      "type ~/.ssh/*": "deny",
      "type ~/.aws/*": "deny",
      "type ~/.gnupg/*": "deny",
      "type ~/.npmrc": "deny",
      "type ~/.netrc": "deny",
      "Get-Content ~/.npmrc": "deny",
      "Get-Content ~/.netrc": "deny",
      "Get-Content ~/.docker/config.json": "deny",
      "Get-Content ~/.kube/config": "deny",
      "Get-Content $env:USERPROFILE/.ssh/*": "deny",
      "Get-Content $env:USERPROFILE/.npmrc": "deny",
      "Get-Content $env:USERPROFILE/.netrc": "deny",
      "Get-Content $HOME/.ssh/*": "deny",
      "Get-Content $HOME/.npmrc": "deny",
      "type $env:USERPROFILE/.ssh/*": "deny",
      "type $env:USERPROFILE/.npmrc": "deny",
      "type $HOME/.ssh/*": "deny",
      "type $HOME/.npmrc": "deny",
      "cat $env:USERPROFILE/.ssh/*": "deny",
      "cat $HOME/.ssh/*": "deny",
      "cat C:/Users/*/.ssh/*": "deny",
      "type C:/Users/*/.ssh/*": "deny",
      "Get-Content C:/Users/*/.ssh/*": "deny",
      "Get-Content *C:\\Users\\*\\.ssh\\*": "deny",
      "cat *C:\\Users\\*\\.ssh\\*": "deny",
      "type *C:\\Users\\*\\.ssh\\*": "deny",
      "Get-Content *opencode*auth.json": "deny",
      "cat *opencode*auth.json": "deny",
      "type *opencode*auth.json": "deny",
      "Get-Content *GitHub CLI*hosts.yml": "deny",
      "cat *GitHub CLI*hosts.yml": "deny",
      "type *GitHub CLI*hosts.yml": "deny",
      "Get-Content *.git-credentials": "deny",
      "cat *.git-credentials": "deny",
      "type *.git-credentials": "deny",
      "cat *.env*": "deny",
      "type *.env*": "deny",
      "Get-Content *.env*": "deny",
      "cat *.env.example": "allow",
      "type *.env.example": "allow",
      "Get-Content *.env.example": "allow"
    },
    "read": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.npmrc": "deny",
      "~/.netrc": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/config": "deny",
      "*\\.ssh\\*": "deny",
      "*\\.aws\\*": "deny",
      "*\\.gnupg\\*": "deny",
      "*\\.npmrc": "deny",
      "*\\.netrc": "deny",
      "*\\.docker\\config.json": "deny",
      "*\\.kube\\config": "deny",
      "C:/Users/*/.ssh/**": "deny",
      "C:/Users/*/.aws/**": "deny",
      "C:/Users/*/.gnupg/**": "deny",
      "C:/Users/*/.npmrc": "deny",
      "C:/Users/*/.netrc": "deny",
      "C:/Users/*/.docker/config.json": "deny",
      "C:/Users/*/.kube/config": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*\\.local\\share\\opencode\\auth.json": "deny",
      "C:/Users/*/.local/share/opencode/auth.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "*\\.config\\gh\\hosts.yml": "deny",
      "C:/Users/*/AppData/Roaming/GitHub CLI/hosts.yml": "deny",
      "*\\AppData\\Roaming\\GitHub CLI\\hosts.yml": "deny",
      "~/.git-credentials": "deny",
      "*\\.git-credentials": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*\\.env": "deny",
      "*\\.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.npmrc": "deny",
      "~/.netrc": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/config": "deny",
      "*\\.ssh\\*": "deny",
      "*\\.aws\\*": "deny",
      "*\\.gnupg\\*": "deny",
      "*\\.npmrc": "deny",
      "*\\.netrc": "deny",
      "*\\.docker\\config.json": "deny",
      "*\\.kube\\config": "deny",
      "C:/Users/*/.ssh/**": "deny",
      "C:/Users/*/.aws/**": "deny",
      "C:/Users/*/.gnupg/**": "deny",
      "C:/Users/*/.npmrc": "deny",
      "C:/Users/*/.netrc": "deny",
      "C:/Users/*/.docker/config.json": "deny",
      "C:/Users/*/.kube/config": "deny",
      "~/.local/share/opencode/auth.json": "deny",
      "*\\.local\\share\\opencode\\auth.json": "deny",
      "C:/Users/*/.local/share/opencode/auth.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "*\\.config\\gh\\hosts.yml": "deny",
      "C:/Users/*/AppData/Roaming/GitHub CLI/hosts.yml": "deny",
      "*\\AppData\\Roaming\\GitHub CLI\\hosts.yml": "deny",
      "~/.git-credentials": "deny",
      "*\\.git-credentials": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*\\.env": "deny",
      "*\\.env.*": "deny",
      "*.env.example": "allow",
      "~/.config/opencode/**": "ask",
      "*\\.config\\opencode\\**": "ask",
      "C:/Users/*/.config/opencode/**": "ask"
    },
    "webfetch": "ask",
    "skill": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    },
    "chrome-devtools_*": "ask"
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@4.0.0"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.6.0"],
      "enabled": true
    }
  }
}
