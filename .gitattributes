# Enforce consistent line endings (LF-canonical)
* text=auto

# Explicitly declare text files
*.md text eol=lf
*.php text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.neon text eol=lf
*.ps1 text eol=lf
*.cmd text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.prettierrc text eol=lf
*.lock text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
